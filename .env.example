# Copy to .env (git-ignored). Everything is optional: with nothing set, Purser
# runs end to end on offline fixtures of the PayPal sandbox contracts and a
# deterministic treasurer.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app; enables signature verification of /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Google AI Studio key (free tier works). Without it the rules engine runs.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Where buyers return after approving; must be reachable by their browser.
PUBLIC_BASE_URL=http://localhost:8790
PORT=8790
# HOST=0.0.0.0
# PURSER_DATA_DIR=data            # or "memory"
# PURSER_PAYPAL_MODE=fixtures     # force offline fixtures even with credentials

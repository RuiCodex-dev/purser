{
  "name": "purser",
  "version": "0.1.0",
  "private": true,
  "description": "Purser: an AI treasurer for group events, built on the PayPal sandbox and the PayPal Agent Toolkit.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/main.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "secret-scan": "node scripts/secret-scan.ts"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "ag-grid-community": "^34.2.0",
    "ag-grid-react": "^34.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "overrides": {
    "mathjs": "15.2.0"
  }
}
